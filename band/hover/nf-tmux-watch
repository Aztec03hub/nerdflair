#!/usr/bin/env python3
"""nf-tmux-watch - notice the instant a tmux server's socket is deleted, say
who was running, and bring the socket back.

WHY THIS EXISTS. On 2026-10-09 a running tmux server (and every session in it)
became unreachable because something deleted /tmp/tmux-1000. Nothing recorded
what. The cause could not be reconstructed afterwards: systemd-tmpfiles ran
once that day, 14 minutes in, and cannot have removed a 15-minute-old socket
(its age test includes ctime, which cannot be backdated; checked empirically),
and nothing in the hopback sweep that was running deletes it. So this watches,
and the next occurrence names its own culprit.

WHAT IT DOES. It finds every tmux server of this user from the kernel's socket
table, puts an inotify watch on each socket's directory and on that
directory's parent, and on any delete or move of the socket or its directory:

  1. records the time, what was deleted, and every process that is running now
     or started in the last 20 seconds, to the log;
  2. runs nf-tmux-heal, which recreates the directory and signals the server
     (SIGUSR1) so it recreates the socket. The server and its sessions were
     never down, only unreachable, so nothing is lost.

It never starts, restarts or kills a tmux server. Heals are rate limited (at
most 6 an hour) so a loop elsewhere cannot make this one.

Pure standard library: inotify through ctypes.
"""
import ctypes
import ctypes.util
import errno
import os
import re
import select
import struct
import subprocess
import sys
import time

IN_MOVED_FROM = 0x00000040
IN_DELETE = 0x00000200
IN_DELETE_SELF = 0x00000400
IN_MOVE_SELF = 0x00000800
IN_Q_OVERFLOW = 0x00004000
MASK = IN_MOVED_FROM | IN_DELETE | IN_DELETE_SELF | IN_MOVE_SELF

UID = os.getuid()
HERE = os.path.dirname(os.path.abspath(__file__))
LOG = os.environ.get("NF_TMUX_WATCH_LOG") or os.path.expanduser("~/.local/state/nerdflair/tmux-watch.log")
HEAL = os.environ.get("NF_TMUX_HEAL") or os.path.join(HERE, "nf-tmux-heal")
RESCAN = float(os.environ.get("NF_TMUX_WATCH_RESCAN", "30"))
HEALS_PER_HOUR = 6
# Only the user's real tmux socket roots are watched: /tmp/tmux-UID, $TMUX_TMPDIR/tmux-UID and
# $XDG_RUNTIME_DIR/tmux-UID of the service's own environment. Any other tmux-UID dir (tests, throwaway
# TMUX_TMPDIRs under /tmp/x, /var/tmp, /dev/shm...) is scratch: logging it makes every test run an incident.
# The watcher's own tests set NF_TMUX_WATCH_SCRATCH=1 to watch their scratch servers.
# NOTE: this allow-list sees only the SERVICE's environment (systemd's user manager: HOME, PATH, XDG_RUNTIME_DIR), never
# the login shell's. A TMUX_TMPDIR set only in a shell leaves that server's socket outside the list, unwatched; put it
# in the unit's Environment= (and reinstall) if you ever set one.
WATCH_SCRATCH = os.environ.get("NF_TMUX_WATCH_SCRATCH") == "1"


def _real_socket_dir(p):
    d = os.path.dirname(p)
    roots = ["/tmp"] + [os.environ[k] for k in ("TMUX_TMPDIR", "XDG_RUNTIME_DIR") if os.environ.get(k)]
    return any(d == os.path.join(r.rstrip("/") or "/", f"tmux-{UID}") for r in roots)

libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)


LOG_MAX = 1_000_000
STATE = os.environ.get("NF_STATE_DIR") or os.path.expanduser("~/.local/state/nerdflair")
LAUNCHER_LOG = os.path.join(STATE, "launcher.log")   # shared with nf-log.sh: `ISO-time component: reason`
# TEST ONLY: makes every inotify_add_watch fail with ENOSPC, to test the report.
TEST_INOTIFY_FAIL = os.environ.get("NF_TEST_INOTIFY_FAIL") == "1"
_stderr_seen = set()


def _stderr_once(key, msg):
    """Last resort when a log cannot be written: the journal, once per kind."""
    if key not in _stderr_seen:
        _stderr_seen.add(key)
        try:
            sys.stderr.write(f"nf-tmux-watch: {msg}\n")
            sys.stderr.flush()
        except (OSError, ValueError):
            pass            # no stderr either: nothing left, and the logger must never raise


_CONTROLS = re.compile(r"[\x00-\x1f\x7f-\x9f]")


def _clean(s):
    """No terminal-active character (ESC, CR, newline, C0, DEL, C1 incl. U+009B) reaches a log:
    process argument lists and paths in these lines are attacker-influenced."""
    return _CONTROLS.sub(" ", str(s))


def _append(path, line):
    """Append one line, one rotated generation, never raise."""
    line = _clean(line)
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        try:
            if os.path.getsize(path) > LOG_MAX:      # one generation is enough: this is a diagnostic
                os.replace(path, path + ".1")
        except FileNotFoundError:
            pass            # no log yet
        except OSError as e:
            _stderr_once("rotate:" + path, f"cannot rotate {path}: {e}")
        # errors="replace": a lone surrogate (os.fsdecode of a non-UTF-8 path) must not raise
        # UnicodeEncodeError, which is not an OSError and would end the watcher
        with open(path, "a", encoding="utf-8", errors="replace") as f:
            f.write(line + "\n")
    except OSError as e:
        _stderr_once("write:" + path, f"cannot write {path}: {e}; lost: {line}")


def log(msg):
    _append(LOG, time.strftime("%Y-%m-%d %H:%M:%S ") + msg)


_state = {}


def transition(key, reason):
    """Report a failure when it starts and a recovery when it ends, not on every
    30 s rescan. reason None means healthy. Goes to the watcher log and to the
    shared launcher log, so one place shows every absorbed failure."""
    prev = _state.get(key)
    if reason == prev:
        return
    _state[key] = reason
    if reason:
        msg = f"{key}: {reason}"
    elif prev:
        msg = f"{key}: recovered (was: {prev})"
    else:
        return
    log(msg)
    _append(LAUNCHER_LOG, time.strftime("%Y-%m-%dT%H:%M:%S%z ") + "watch: " + msg)


SS_LINE = re.compile(r"^\S+\s+\S+\s+\d+\s+\d+\s+(\S.*?)\s+\d+\s+\*\s+\d+\s+users:\(\(\"tmux: server\"")


def socket_paths():
    """Paths of every listening tmux server socket of this user, from the
    kernel, which still names a path whose directory has been deleted. A
    failure of ss, or a change of its format, is reported (see transition)."""
    try:
        r = subprocess.run(["ss", "-xlnp"], capture_output=True, encoding="utf-8", errors="replace", timeout=5)
    except (OSError, subprocess.SubprocessError) as e:
        transition("ss", f"cannot run ss: {e}")
        return []
    if r.returncode != 0:
        transition("ss", f"ss exited {r.returncode}: {r.stderr.strip()[:200]}")
        return []
    paths, unparsed = [], []
    for line in r.stdout.splitlines():
        m = SS_LINE.match(line)
        if m and f"/tmux-{UID}/" in m.group(1):
            if not WATCH_SCRATCH and not _real_socket_dir(m.group(1)):
                continue
            paths.append(m.group(1))
        elif f"/tmux-{UID}/" in line:
            unparsed.append(line)       # ours by path but not in the format we read
    if unparsed and not paths:
        transition("ss", f"output format not recognised, watching nothing: {unparsed[0][:200]}")
    else:
        transition("ss", None)
    return paths


def suspects():
    """Processes that are running now or started in the last 20 s. Whatever
    deleted the socket is usually gone by the time we read this, but its
    parent, its siblings and whatever launched it often are not."""
    try:
        out = subprocess.run(["ps", "-eo", "pid=,ppid=,etimes=,user=,args="],
                             capture_output=True, encoding="utf-8", errors="replace", timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ["(ps failed)"]
    keep = []
    for line in out.splitlines():
        parts = line.split(None, 4)
        if len(parts) < 5:
            continue
        pid, ppid, age, user, args = parts
        if (age.isdigit() and int(age) <= 20) or re.search(r"\b(rm|rmdir|find|tmpfiles|tmpreaper|mv)\b", args):
            if "nf-tmux-watch" in args or args.startswith("ps "):
                continue
            keep.append(f"    pid={pid} ppid={ppid} age={age}s user={user} {args[:200]}")
    return keep[:60]


class Watcher:
    def __init__(self):
        self.fd = libc.inotify_init1(os.O_NONBLOCK)
        if self.fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1")
        self.wd = {}            # watch descriptor -> directory
        self.heals = []
        self.last_limit_note = 0.0

    def add(self, d):
        if d in self.wd.values() or not os.path.isdir(d):
            return
        if TEST_INOTIFY_FAIL:
            wd = -1
            ctypes.set_errno(errno.ENOSPC)
        else:
            wd = libc.inotify_add_watch(self.fd, d.encode(), MASK)
        if wd >= 0:
            self.wd[wd] = d
            transition(f"watch {d}", None)
        else:
            transition(f"watch {d}", f"inotify_add_watch failed, deletions here will go unnoticed: {os.strerror(ctypes.get_errno())}")

    def rescan(self):
        for p in socket_paths():
            d = os.path.dirname(p)
            self.add(d)
            self.add(os.path.dirname(d))

    def heal(self, why):
        now = time.time()
        self.heals = [t for t in self.heals if now - t < 3600]
        if len(self.heals) >= HEALS_PER_HOUR:
            # Past the limit say so once an hour, not once per event, so a
            # storm cannot fill the disk through this log either.
            if now - self.last_limit_note > 3600:
                self.last_limit_note = now
                log(f"not healing or recording: already {HEALS_PER_HOUR} heals in the last hour (something keeps deleting it): {why}")
            return
        log(f"DELETED: {why}")
        for line in suspects():
            log(line)
        self.heals.append(now)
        time.sleep(0.2)          # let whatever is deleting finish before recreating
        try:
            r = subprocess.run([HEAL], capture_output=True, encoding="utf-8", errors="replace", timeout=30)
        except (OSError, subprocess.SubprocessError) as e:
            transition("heal", f"could not run {HEAL}: {e}")
            return
        # The measured outcome, not the exit code alone: did the socket come back?
        deadline = time.time() + 3
        while True:
            missing = [p for p in socket_paths() if not os.path.exists(p)]
            if not missing or time.time() >= deadline:
                break
            time.sleep(0.25)
        err = " ".join(r.stderr.split())
        if missing:
            transition("heal", f"NOT HEALED rc={r.returncode}, still missing {missing}: {err or 'no reason given'}")
        else:
            transition("heal", None)
            log(f"healed rc={r.returncode} socket restored {err}".rstrip())

    def run(self):
        self.rescan()
        log(f"watching {sorted(set(self.wd.values()))}")
        next_scan = time.time() + RESCAN
        while True:
            ready, _, _ = select.select([self.fd], [], [], max(0.1, next_scan - time.time()))
            if ready:
                try:
                    buf = os.read(self.fd, 65536)
                except BlockingIOError:
                    buf = b""
                i = 0
                hit = None
                while i < len(buf):
                    wd, mask, _cookie, ln = struct.unpack_from("iIII", buf, i)
                    name = buf[i + 16:i + 16 + ln].rstrip(b"\0").decode(errors="replace")
                    i += 16 + ln
                    if mask & IN_Q_OVERFLOW:
                        # The kernel dropped events, so a deletion may be among them: assume one.
                        log("inotify queue overflowed; healing and rescanning to be safe")
                        hit = "inotify queue overflow (events lost)"
                        continue
                    d = self.wd.get(wd, "?")
                    # Only what concerns a tmux socket directory or its socket.
                    if mask & (IN_DELETE_SELF | IN_MOVE_SELF) and f"/tmux-{UID}" in d:
                        hit = f"directory {d} itself"
                    elif mask & (IN_DELETE | IN_MOVED_FROM) and (name == f"tmux-{UID}" or (d.endswith(f"/tmux-{UID}") and name == "default")):
                        # EXACT names. A prefix match let any other user create
                        # and delete /tmp/tmux-1000-x in a loop and make this
                        # service log, scan processes and heal for ever.
                        hit = f"{os.path.join(d, name)}"
                    if mask & (IN_DELETE_SELF | IN_MOVE_SELF):
                        self.wd.pop(wd, None)      # the kernel drops the watch with its target
                if hit:
                    self.heal(hit)
                    self.rescan()
            if time.time() >= next_scan:
                self.rescan()
                next_scan = time.time() + RESCAN


def main():
    if "--once" in sys.argv:           # for tests: print what would be watched
        print("\n".join(socket_paths()))
        return
    Watcher().run()


if __name__ == "__main__":
    main()
