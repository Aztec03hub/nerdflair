[Unit]
Description=nerdflair: notice and repair a deleted tmux socket
# Bounded on purpose: five starts in ten minutes and systemd stops trying,
# so a failing watcher can never become a restart loop.
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.nerdflair/bin/nf-tmux-watch
Restart=on-failure
# A restart (install.sh does one after a change) stops only the watcher: a heal it started a moment earlier is two quick
# steps (mkdir, SIGUSR1) and must finish, not be killed between them by the default KillMode=control-group.
KillMode=process
RestartSec=30
Nice=10
MemoryMax=64M
TasksMax=16

[Install]
WantedBy=default.target
