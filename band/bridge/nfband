#!/usr/bin/env bash
# nfband - start Claude Code with hover panels on the status line.
#
#   nfband [anything you would pass to claude]
#
# Everything is in the one wrapper: it holds the pty, reads the pointer out of
# the input stream, works out where each readout sits, and paints the panels.
# Nothing is installed, patched or injected, and nothing is left behind when
# it exits, so a Claude Code update changes nothing here.
#
# NOTE FOR ANYONE READING THE HISTORY. An earlier nfband armed Claude Code's
# Bun inspector with BUN_INSPECT. Do not bring that back: it opens an
# unauthenticated debugger on a loopback port, and code execution over that
# port is code execution inside a process holding your credentials. It also
# never worked for this purpose; see inspector-lab/README.md.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ -z "${TMUX:-}" ]]; then
  # The panels can still be painted, but without tmux there is no way to read
  # back what a panel covers, so hiding one would leave a hole. Say so rather
  # than let it look broken.
  echo "nfband: not inside tmux; hover panels need it to restore what they cover" >&2
fi

exec python3 "$HERE/nfpty.py" "$@"
