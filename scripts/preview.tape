# After recording, optimize with: gifsicle -O3 --colors 128 --lossy=80 assets/images/preview.gif -o assets/images/preview.gif
Output assets/images/preview.gif

Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 20
Set Width 1105
Set Height 148
Set Padding 2
Set Theme "Catppuccin Mocha"
Set LoopOffset 0%
Set Framerate 4
Set PlaybackSpeed 1

Hide
Type "bash scripts/animated-preview.sh"
Enter
Sleep 1s
Show
Sleep 14s
