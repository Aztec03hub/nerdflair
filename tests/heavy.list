# Checks that take over 15 s, or sit close enough to it that a busy machine times them out.
# One command per line, run from the repo root by tests/full.sh. The comment is the measured or estimated time.
bash tests/difftest.sh -j 4   # estimate: minutes at -j 1 (whole corpus), not measured
bash tests/difftest-repeat.sh   # TIMEOUT at 15 s (it runs difftest 20 times), not measured to the end
bash tests/silent-failures.sh   # TIMEOUT at 15 s, not measured to the end
bash tests/git-head-fallback.sh   # TIMEOUT at 15 s (16.1s), not measured to the end
bash tests/launcher-logging.sh   # 11.8s measured, near the limit so heavy
bash tests/log-sanitizers.sh   # 12.9s measured, near the limit so heavy
bash tests/bridge-selfchecks.sh   # 14.2s measured; its parts run singly in quick.list
bash tests/test-nerdflair.sh   # 13.8s, FAILED under an empty temp HOME (fixture git needs an identity); run it with a real HOME
bash tests/loadtest.sh --workers 20 --secs 120   # estimate: 120s+, not measured (spawns 20 workers)
python3 band/bridge/hover-e2e.py   # estimate: minutes, not measured, uses the ambient tmux so agents never run it
python3 band/bridge/hover-covered-e2e.py   # estimate: minutes, not measured, needs tmux
python3 band/bridge/hover-highlight-e2e.py   # estimate: minutes, not measured, needs tmux
python3 band/bridge/hover-linger-e2e.py   # estimate: minutes, not measured, needs tmux
python3 band/bridge/hover-stale-e2e.py   # estimate: minutes, not measured, needs tmux
