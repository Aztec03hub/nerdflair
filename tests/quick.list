bash tests/tmux-heal.sh   # 0.7s, private TMUX_TMPDIR server
bash tests/transcript-tail.sh   # 0.9s
bash tests/untracked-dir.sh   # 0.2s
bash tests/validate-ledger.sh   # 0.0s, exits 77 (SKIP) without a ledger and the built binary
bash tests/silent-failures.sh --part 1/10   # 3.9s at load1 ~13 (slowest part < 7 s; cargo-test is not in any part, heavy.list runs it)
bash tests/silent-failures.sh --part 2/10   # 2.4s at load1 ~13 (slowest part < 7 s; cargo-test is not in any part, heavy.list runs it)
bash tests/silent-failures.sh --part 3/10   # 2.9s at load1 ~13 (slowest part < 7 s; cargo-test is not in any part, heavy.list runs it)
