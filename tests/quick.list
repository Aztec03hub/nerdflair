# Checks that finish well under 15 s. One command per line, run from the repo root by tests/quick.sh.
# The comment after "   #" is the measured wall time (2026-10-23, nice 19 / ionice idle, shared machine, warm cargo target).
# Anything measured over ~10 s lives in heavy.list instead, so a busy machine doesn't turn it into a TIMEOUT.
python3 band/bridge/mklayout.py --selfcheck   # 0.1s
python3 band/bridge/nfpty.py --nfpty-selfcheck   # 0.1s
python3 band/bridge/cells-table.py   # 0.3s
python3 band/bridge/shadow.py --selfcheck   # 0.1s
python3 tests/price-recount.py --selfcheck   # 0.0s
cargo test --release --manifest-path rust/Cargo.toml   # 0.0s warm (a cold build of the test harness is heavy)
claude plugin test band   # 2.1s
bash tests/band-switch.sh   # 1.8s
bash tests/burn-block-golden.sh   # 0.2s
bash tests/difftest-unstable-guard.sh   # 1.0s
bash tests/empty-home.sh   # 0.0s
bash tests/gen-payloads.sh   # 1.1s
bash tests/install-rc.sh   # 2.3s
bash tests/json-isolation.sh   # 0.0s
bash tests/ledger-big.sh   # 1.4s
bash tests/ledger-concurrency.sh   # 4.4s
bash tests/ledger-widen.sh   # 0.1s
bash tests/limits-costless.sh   # 1.3s
bash tests/mcp-cap.sh   # 0.3s
bash tests/mcp-per-project.sh   # 4.0s
bash tests/placeholders.sh   # 1.0s
bash tests/plugin-sync.sh   # 0.7s
bash tests/popup-errors.sh   # 0.0s
bash tests/rc-sync.sh   # 0.2s
bash tests/row3-gap.sh   # 0.6s
bash tests/tmux-heal.sh   # 0.7s, private TMUX_TMPDIR server
bash tests/transcript-tail.sh   # 0.9s
bash tests/validate-ledger.sh   # 0.0s, exits 77 (SKIP) without a ledger and the built binary
bash tests/silent-failures.sh --part 1/5   # 7.1s; the 5 parts together run every case once (full form in heavy.list)
bash tests/silent-failures.sh --part 2/5   # 8.8s; the 5 parts together run every case once (full form in heavy.list)
bash tests/silent-failures.sh --part 3/5   # 5.8s; the 5 parts together run every case once (full form in heavy.list)
bash tests/silent-failures.sh --part 4/5   # 7.5s; the 5 parts together run every case once (full form in heavy.list)
bash tests/silent-failures.sh --part 5/5   # 9.0s; the 5 parts together run every case once (full form in heavy.list)
bash tests/git-head-fallback.sh --part 1/3   # 5.9s; the 3 parts together run every case once (full form in heavy.list)
bash tests/git-head-fallback.sh --part 2/3   # 5.4s; the 3 parts together run every case once (full form in heavy.list)
bash tests/git-head-fallback.sh --part 3/3   # 6.1s; the 3 parts together run every case once (full form in heavy.list)
